#!/usr/bin/env python3
import tomlkit
import argparse
import subprocess
import getpass
import os
import shutil
from pathlib import Path

USER = os.environ.get("USER") or getpass.getuser()
HOME = os.environ.get("HOME", f"/HOME/{USER}")
LOCAL = Path(HOME) / ".local/share/osbox"
WORKDIR = Path("/tmp/osbox")
CONFIG = Path(HOME) / ".config/osbox"
DRY_RUN = False

class Recipe:
    def __init__(self, config):
        self.config = config
        self.tag = config.get("tag", "")
        self.image = config.get("image", "")
        self.contfile = [f"FROM {self.image}"]
        for key, value in config.get("ARG", {}).items():
            self.contfile.append(f'ARG {key}="{value}"')
        self.contfile += self.pkg_install()
        self.contfile += self.setup_host_spawn()
        self.contfile += self.setup_user()
        self.contfile += ['CMD ["sleep", "infinity"]']

    def pkg_install(self):
        print("- Installing packages")
        packs = self.config.get("script", {}).get("pkg_install", {})
        pkgs = " ".join(pkg for pkgs_list in packs.values() for pkg in pkgs_list)
        lines = [
            "COPY scripts/pkg-install /tmp",
            "RUN chmod +x /tmp/pkg-install",
        ]
        if pkgs:
            lines.append(f"RUN /tmp/pkg-install {pkgs}")
        return lines

    def setup_user(self):
        print("- Setting up user")
        contarg = self.config.get("ARG", {})
        passwd = contarg.get("PASSWD")
        lines = []
        if passwd is None:
            passwd = getpass.getpass("Enter password for user: ")
            lines.append(f'ARG PASSWD="{passwd}"')
        return lines + [
            "COPY scripts/setup-user /tmp",
            "RUN chmod +x /tmp/setup-user",
            "RUN /tmp/setup-user",
            'USER "${USER}"',
            'WORKDIR "/home/${USER}"',
        ]

    def setup_host_spawn(self):
        print("- Installing host-spawn")
        if not DRY_RUN:
            import requests
            url = "https://api.github.com/repos/1player/host-spawn/releases/latest"
            r = requests.get(url)
            r.raise_for_status()
            host_spawn_v = r.json()["tag_name"]
            arch = os.uname().machine
            down_url = f"https://github.com/1player/host-spawn/releases/download/{host_spawn_v}/host-spawn-{arch}"
            r = requests.get(down_url, stream=True, allow_redirects=True)
            r.raise_for_status()

            print("- Downloading host-spawn")
            with open(f"{WORKDIR}/host-spawn", 'wb') as f:
                for chunk in r.iter_content(8192):
                    f.write(chunk)

        return [
            "COPY host-spawn /usr/local/bin/host-spawn",
            "RUN chmod +x /usr/local/bin/host-spawn"
        ]


def setup_workdir():
    WORKDIR.mkdir(parents=True, exist_ok=True)
    os.chdir(WORKDIR)
    shutil.copytree(LOCAL / "scripts", WORKDIR / "scripts", dirs_exist_ok=True)
    shutil.copytree(CONFIG / "recipes", WORKDIR / "recipes", dirs_exist_ok=True)

def load_config(cfg_path):
    with open(cfg_path, "rb") as f:
        return tomlkit.load(f)

def write_conf(contfile, path):
    Path(path).write_text("\n".join(contfile))
    print(f"- Containerfile written to {path}")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-f", "--config", help="Path to the TOML config file")
    parser.add_argument("-dr", "--dry-run", action="store_true", help="Dry run mode")
    parser.add_argument("image", help="Image name to build", nargs="*")
    args = parser.parse_args()

    if args.dry_run:
        global DRY_RUN
        DRY_RUN = True

    setup_workdir()
    if args.config:
        config = load_config(args.config)
        recipe = Recipe(config)

        if not DRY_RUN:
            shutil.copy(args.config, CONFIG / f"{recipe.tag}.toml")
    else:
        if len(args.image) == 1:
            # TODO: Implement default barebone Containerfile logic
            raise SystemExit("default config for image is not implemented yet")
        elif len(args.image) > 1:
            raise SystemExit("only one image name or config file is allowed.")
        else:
            raise SystemExit("image name or config is not provided.")

    if DRY_RUN:
        print("\n".join(recipe.contfile))
    else:
        contf_path = f"Containerfile.{recipe.tag}"
        write_conf(recipe.contfile, contf_path)
        subprocess.run(
            ["podman", "build", "-t", recipe.tag, "--file", contf_path], check=True
        )

if __name__ == "__main__":
    main()
