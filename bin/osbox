#!/usr/bin/env python3
import os
import getpass
import argparse
import subprocess
import tomlkit

from pathlib import Path

USER = os.environ.get("USER") or getpass.getuser()
HOME = os.environ.get("HOME", f"/HOME/{USER}")
CONFIG = Path(HOME) / ".config/osbox"

def setup_display():
    args = []
    WAYLAND_DISPLAY = os.environ.get("WAYLAND_DISPLAY")
    XDG_RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR")
    DISPLAY = os.environ.get("DISPLAY")

    if not WAYLAND_DISPLAY and not DISPLAY:
        return args

    if WAYLAND_DISPLAY and XDG_RUNTIME_DIR:
        is_xdg_soc = Path(str(Path(XDG_RUNTIME_DIR) / WAYLAND_DISPLAY)).is_socket()
        if WAYLAND_DISPLAY and is_xdg_soc:
            print("- Using Wayland")
            args += ["-e", f"WAYLAND_DISPLAY={WAYLAND_DISPLAY}"]
            args += ["-v", f"{XDG_RUNTIME_DIR}/{WAYLAND_DISPLAY}:/tmp/{WAYLAND_DISPLAY}"]

    if DISPLAY:
        XAUTH = os.environ.get("XAUTHORITY", f"{HOME}/.Xauthority")
        args += ["-e", f"DISPLAY={DISPLAY}"]
        args += ["-v", "/tmp/.X11-unix:/tmp/.X11-unix:ro"]
        if Path(XAUTH).is_file():
            args += ["-e", f"XAUTHORITY=/run/user/{USER}/.Xauthority"]
            args += ["-v", f"{XAUTH}:/run/user/{USER}/.Xauthority:ro"]

    return args

def setup_graphics():
    return [
		"--device", "/dev/dri",
		"--group-add", "video",
    ]

def setup_audio():
    args = []
    uid = os.getuid()
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    pulse_socket = Path(runtime_dir) / "pulse" / "native"
    pipewire_socket = Path(runtime_dir) / "pipewire-0"

    if pulse_socket.is_socket():
        print("- Activating PulseAudio pass-through...")
        args += ["-v", f"{pulse_socket}:/tmp/pulse-socket:ro"]
        args += ["-e", "PULSE_SERVER=unix:/tmp/pulse-socket"]
        return args

    if pipewire_socket.is_socket():
        print("- Activating PipeWire pass-through...")
        args += ["-v", f"{pipewire_socket}:/tmp/pipewire-0:ro"]
        args += ["-e", "PIPEWIRE_SOCKET=unix:/tmp/pipewire-0"]
        if pulse_socket.is_socket():
            args += ["-v", f"{pulse_socket}:/tmp/pulse-socket:ro"]
            args += ["-e", "PULSE_SERVER=unix:/tmp/pulse-socket"]
        return args

    print(f"- No active audio socket detected at {pulse_socket} or {pipewire_socket}. Audio disabled.")
    return args


def setup_themes():
    args = []
    theming_paths = (
        f"{HOME}/.config/gtk-3.0:/home/{USER}/.config/gtk-3.0:Z,ro",
        f"{HOME}/.config/gtk-4.0:/home/{USER}/.config/gtk-4.0:Z,ro",
        f"{HOME}/.themes:/home/sonia/.themes:Z,ro",
        f"{HOME}/.icons:/home/sonia/.icons:Z,ro",
        f"{HOME}/.local/share/icons:/home/{USER}/.local/share/icons:Z,ro",
    )

    for path_spec in theming_paths:
        host_path = path_spec.split(":", 1)[0]
        if Path(host_path).exists():
            args += ["-v", path_spec]

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    args += [
        "-e", f"DBUS_SESSION_BUS_ADDRESS=unix:path={runtime_dir}/bus",
        "-v", f"{runtime_dir}/bus:{runtime_dir}/bus",
        "-e", "GTK_USE_PORTAL=1",
    ]
    return args

def setup_terminal():
    return [
        "-e", "TERM",
        "-e", "COLORTERM",
    ]

def is_cont_exists(tag):
    return subprocess.run(
        ["podman", "container", "exists", tag],
        capture_output=True, check=False
    ).returncode == 0

def is_cont_alive(tag):
    return subprocess.run(
        ["podman", "inspect", "--format", "'{{.State.Running}}'", tag],
        capture_output=True, check=False, text=True
    ).stdout.strip("\n'") == "true"

def load_config(cfg_path) -> dict:
    with open(cfg_path, "rb") as f:
        return tomlkit.load(f)

def ask_yn(question, default = False):
    suffix = " [Y/n]: " if default else " [y/N]: "
    while True:
        answer = input(question + suffix).strip().lower()
        if answer == "":
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["start", "stop", "rm"], help="Action to perform")
    parser.add_argument("tag", help="Container name")
    parser.add_argument(
        "-e", "--ephemeral", action="store_true",
        help="Ephemeral mode, automatically remove container on stop."
    )

    args, podman_args = parser.parse_known_args()
    tag = args.tag

    if args.action == "start":
        podargs = [
            "-d",
            "--userns=keep-id",
            "--name", tag,
            "--security-opt", "label=type:container_runtime_t",
        ]

        confpath = CONFIG / f"{tag}.toml"
        config = load_config(confpath)
        conf_podargs: dict = config.get("podman_args", [])
        for key, value in conf_podargs.items():
            prefix = "--" if len(key) > 1 else "-"
            if isinstance(value, list):
                for v in value:
                    podargs += [f"{prefix}{key}", str(v)]
            else:
                podargs += [f"{prefix}{key}", str(value)]

        if args.ephemeral:
            podargs += ["--rm"]
            print("- Auto remove container on stop")

        podargs += setup_display()
        podargs += setup_graphics()
        podargs += setup_audio()
        podargs += setup_themes()
        podargs += setup_terminal()
        podargs += podman_args

        cmd_run = ["podman", "run"] + podargs + [tag]
        cmd_enter = ["podman", "exec", "-it", tag, "/bin/bash"]
        cmd_start = ["podman", "start", tag]
        if is_cont_exists(tag):
            print(f"- Container {tag} already exists, entering...")
            if len(podman_args) > 0:
                print("- Warning: Extra podman arguments are ignored when starting an existing container, stop container first to apply.")
            if not is_cont_alive(tag):
                subprocess.run(cmd_start, check=True)
            subprocess.run(cmd_enter, check=True)
            return

        subprocess.run(cmd_run, check=True)
        subprocess.run(cmd_enter, check=True)

    elif args.action == "stop":
        stop = ask_yn(f"Stop container '{tag}'?", False)
        if is_cont_exists(tag) and stop:
            cmd_stop = ["podman", "stop", "-t", '0', tag]
            subprocess.run(cmd_stop, check=True)
        elif not stop:
            pass
        else:
            print(f"- Container {tag} already stopped.")

    elif args.action == "rm":
        rm = ask_yn(f"Remove container '{tag}'?", False)
        if is_cont_exists(tag) and rm:
            cmd_rm = ["podman", "rm", "-f", tag]
            subprocess.run(cmd_rm, check=True)
        elif not rm:
            pass
        else:
            print(f"- Container {tag} does not exist.")

if __name__ == "__main__":
    main()
