#!/usr/bin/env python3
import tomlkit
import argparse
import subprocess
import getpass
import os
import shutil

from re import sub
from pathlib import Path

def setup_workdir():
    user = subprocess.check_output(["whoami"]).decode().strip()
    home = os.environ.get("home", f"/home/{user}")
    path = f"{home}/.local/share/osbox"
    workdir = "/tmp/osbox"
    Path(f"{workdir}").mkdir(parents=True, exist_ok=True)
    os.chdir(f"{workdir}")
    shutil.copytree(
        f"{path}/scripts", f"{workdir}/scripts", dirs_exist_ok=True
    )
    shutil.copytree(
        f"{path}/recipe", f"{workdir}/recipe", dirs_exist_ok=True
    )

def load_config(cfg_path):
    with open(f"{cfg_path}", "rb") as f:
        return tomlkit.load(f)

def pkg_install(config):
    lines = [
        "COPY scripts/pkg_install /tmp",
        "RUN chmod +x /tmp/pkg_install",
        "RUN /tmp/pkg_install "
    ]
    packs = config.get("script", {}).get("pkg_install")
    pkgs = []
    for pack in packs.keys():
        lines[2] += " ".join(packs[pack]) + " "
    return lines

def setup_user():
    passwd = getpass.getpass("Enter password for user: ")
    return [
        f'ARG PASSWD="{passwd}"',
        "COPY scripts/setup_user /tmp",
        "RUN chmod +x /tmp/setup_user",
        "RUN /tmp/setup_user",
        'USER "${USER}"',
        'WORKDIR "/home/${USER}"'
    ]

def write_conf(contfile, path):
    with open(path, "w") as f:
        f.write("\n".join(contfile))
    print(f"- Containerfile written to {path}")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-f", "--config", help="Path to the TOML config file",
    )
    parser.add_argument(
        "-dr", "--dry-run", action="store_true", help="Dry run mode"
    )
    parser.add_argument(
        "image", help="Image name to build", nargs="*",
    )
    args = parser.parse_args()

    setup_workdir()
    if args.config:
        config = load_config(args.config)
    else:
        if len(args.image) == 1:
            # TODO: Implement default barebone Containerfile logic
            raise SystemExit("default config for image is not implemented yet")
        elif len(args.image) > 1:
            raise SystemExit("only one image name or config file is allowed.")
        else:
            raise SystemExit("image name or config is required.")

    contfile = []
    tag = config.get("tag", {})
    image = config.get("image", {})
    contfile.append(f"FROM {image}")
    contarg = config.get("ARG", {})

    for confarg in contarg.items():
        contfile.append(f"ARG {confarg[0]}={confarg[1]}")
    contfile += pkg_install(config)
    contfile += setup_user()
    contfile += ['CMD ["sleep", "infinity"]']

    if args.dry_run:
        print("\n".join(contfile))
    else:
        contf_path = f"Containerfile.{tag}"
        write_conf(contfile, contf_path)
        subprocess.run(
            ["podman", "build", "-t", tag, "--file", contf_path], check=True
        )

if __name__ == "__main__":
    main()
