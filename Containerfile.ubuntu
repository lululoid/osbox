FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive
ARG USER=sonia
ARG USER_UID=1000
ARG USER_GID=1000

COPY scripts/apt_install /tmp
COPY scripts/go_install /tmp
COPY scripts/setup_user /tmp

RUN chmod +x /tmp/apt_install /tmp/go_install /tmp/setup_user
RUN /tmp/apt_install
RUN /tmp/go_install
RUN /tmp/setup_user

USER "${USER}"
WORKDIR "/home/${USER}"

CMD ["sleep", "infinity"]
