FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive
ARG USER=sonia
ARG USER_UID=1000
ARG USER_GID=1000

RUN apt-get update && apt-get install -y \
  git \
  curl \
  wget \
  x11-apps \
  mesa-utils \
  zsh \
  sudo \
  pulseaudio \
  pulseaudio-utils \
  libpulse0

RUN <<EOF
  apt-get install -y \
  build-essential \
  python3 \
  python3-pip \
  golang-go
EOF

RUN go install github.com/jesseduffield/lazygit@latest
RUN rm -rf /var/lib/apt/lists/*

RUN userdel -r ubuntu 2>/dev/null || true \
    && groupdel ubuntu 2>/dev/null || true \
    && groupadd -g "${USER_GID}" "${USER}" \
    && useradd -m -u "${USER_UID}" -g "${USER}" -s /bin/zsh "${USER}" \
    && echo "${USER}: " | chpasswd \
    && echo "${USER} ALL=(ALL) ALL" > /etc/sudoers.d/${USER}

USER "${USER}"
WORKDIR "/home/${USER}"

CMD ["sleep", "infinity"]
