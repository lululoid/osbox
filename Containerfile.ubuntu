FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive
ARG USER=sonia
ARG USER_UID=1000
ARG USER_GID=1000

RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    x11-apps \
    mesa-utils \
    zsh
RUN apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    golang-go
RUN go install github.com/jesseduffield/lazygit@latest
RUN rm -rf /var/lib/apt/lists/*

RUN usermod -u 1001 ubuntu && groupmod -g 1001 ubuntu
RUN getent group "${USER}" >/dev/null || groupadd -o -g "${USER_GID}" "${USER}" \
    && id "${USER}" >/dev/null 2>&1 || useradd -m -o -u "${USER_UID}" -g "${USER}" -s /bin/zsh "${USER}"
USER "${USER}"
WORKDIR "/home/${USER}"

CMD ["sleep", "infinity"]
