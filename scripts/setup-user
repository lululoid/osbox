#!/bin/bash

if [ -n "$USER_UID" ] && [ -n "$USER_GID" ] && [ -n "$USER" ]; then
	defuser=$(getent passwd | awk -F: -v pgid=1000 '$4 == pgid { print $1 }')
	userdel -r "$defuser" 2>/dev/null || true &&
		groupdel "$defuser" 2>/dev/null || true &&
		groupadd -g "${USER_GID}" "${USER}" &&
		useradd -m -u "${USER_UID}" -g "${USER}" -s /bin/zsh "${USER}" &&
		echo "${USER}:${PASSWD}" | chpasswd &&
		echo "${USER} ALL=(ALL) ALL" >/etc/sudoers.d/${USER}
else
	echo "Error: USER_UID, USER_GID, or USER is not set." >&2
	exit 1
fi
