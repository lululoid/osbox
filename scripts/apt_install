#!/bin/bash
PKGS=(
	git
	curl
	wget
	x11-apps
	mesa-utils
	zsh
	sudo
	pulseaudio
	pulseaudio-utils
	libpulse0
	libgtk-3-0 libgtk-4-1 gtk2-engines-murrine
	xdg-desktop-portal-gtk
	adwaita-icon-theme
	fonts-dejavu-core
	dbus
	libcanberra-gtk3-module
	at-spi2-core

)
PKGS_DEV=(
	build-essential
	python3
	python3-pip
	golang-go
)

PKGS+=("${PKGS_DEV[@]}")
apt-get update && apt-get install -y "${PKGS[@]}"
rm -rf /var/lib/apt/lists/*
